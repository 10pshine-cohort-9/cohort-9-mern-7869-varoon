# ──────────────────────────────────────────
# Server
# ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ──────────────────────────────────────────
# MySQL Database
# ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=notes_app

# Connection pool settings
DB_CONNECTION_LIMIT=10

# ──────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────
JWT_SECRET=Superman
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────
# Bcrypt
# ──────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10
